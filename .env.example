# =============================================================================
# .env.example — full reference of every environment variable the app reads.
# Copy to .env and edit. Variables grouped by bounded context / concern.
#
# Conventions:
# - Booleans accept: true / false / 1 / 0 / yes / no / on / off (pydantic-settings).
# - Lists are JSON: ROOT_PUBLIC_CORS_ORIGINS=["a","b"]
# - Empty values mean "use the default" (commented lines show that default).
# - Restart the process to pick up any change — everything is read once at start.
#
# Cross-refs:
# - Feature flags  → docs/subsystems/feature-flags.md
# - Auth & perms   → docs/subsystems/auth-permissions.md
# - MySQL infra    → docs/infra/mysql.md
# - SMTP recovery  → docs/infra/smtp.md
# - Deployment     → docs/infra/cpanel.md
# =============================================================================


# -----------------------------------------------------------------------------
# ROOT — app-wide mode, CORS, rate limits
# Source: src/root/config.py
# -----------------------------------------------------------------------------

# Human-readable name shown in <title>, OpenAPI docs and Jinja templates.
ROOT_APP_NAME=Shop Admin

# dev  → CORS wide open, default rate limit 10000/min (debugging).
# prod → CORS restricted to *_CORS_ORIGINS below, strict rate limits.
ROOT_APP_ENV=dev

# JSON arrays — used ONLY when ROOT_APP_ENV=prod.
# ROOT_PUBLIC_CORS_ORIGINS=["https://your-domain.com","https://www.your-domain.com"]
# ROOT_ADMIN_CORS_ORIGINS=["https://admin.your-domain.com"]

# flask-limiter format ("N per period"). Used ONLY in prod.
# ROOT_RATE_LIMIT_DEFAULT=200 per minute
# ROOT_RATE_LIMIT_LOGIN=5 per minute
# ROOT_RATE_LIMIT_ORDER=10 per minute
# ROOT_RATE_LIMIT_RECOVERY=3 per minute
# Customer-flow limits — applied in every env, even dev, since these endpoints
# are abuse-prone. Dev keeps the high default for other routes.
# ROOT_RATE_LIMIT_CUSTOMER_REGISTER=5 per hour
# ROOT_RATE_LIMIT_CUSTOMER_RECOVER=3 per hour


# -----------------------------------------------------------------------------
# INFRA — shared infrastructure (DB pool)
# Source: src/shared/adapters/driven/config.py
# -----------------------------------------------------------------------------

# SQLAlchemy URL. Examples:
#   Local Docker (compose ships mysql:5.7):
#     mysql+pymysql://shop:shop@db:3306/shop?charset=utf8mb4
#   Bare-metal Linux:
#     mysql+pymysql://shop:shop@localhost:3306/shop?charset=utf8mb4
#   CPanel shared hosting:
#     mysql+pymysql://cpaneluser_dbuser:S3cret@localhost:3306/cpaneluser_dbname?charset=utf8mb4
#   Local SQLite (dev/tests only — NOT supported in prod):
#     sqlite:///data/shop.db
INFRA_DATABASE_URL=mysql+pymysql://shop:shop@db:3306/shop?charset=utf8mb4

# Connection-pool tuning (SQLAlchemy create_engine).
INFRA_DB_POOL_SIZE=5
INFRA_DB_POOL_RECYCLE=3600
INFRA_DB_POOL_PRE_PING=true


# -----------------------------------------------------------------------------
# ACCESS — auth, JWT, default admin, recovery, owner permissions
# Source: src/access/config.py · docs/subsystems/auth-permissions.md
# -----------------------------------------------------------------------------

# HS256 secret for signing JWTs. MUST be ≥ 32 chars in prod. Rotating this value
# invalidates every existing token (forced re-login).
ACCESS_JWT_SECRET=change-me-in-production

# Default admin bootstrapped on first start. Re-bootstrap is idempotent.
# Login MUST NOT contain '@' — that character is reserved for customer emails
# and triggers the customer dispatch path in POST /auth/login.
ACCESS_DEFAULT_LOGIN=admin
ACCESS_DEFAULT_PASSWORD=changeme

# Optional personal Telegram chat id for the default admin. Login codes and
# order notifications are sent to admins.telegram_chat_id, NOT to the legacy
# global settings.telegram_chat_id.
# ACCESS_DEFAULT_TELEGRAM_CHAT_ID=

# When true, the lone admin is bootstrapped as `superadmin` (full power).
# Production rule: set to false and pin per-permission ACCESS_OWNER_CAN_* below.
ACCESS_PROMOTE_TO_SUPERADMIN=true

# Admin recovery-code (email/Telegram) policy.
# ACCESS_RECOVERY_CODE_TTL_MINUTES=5
# ACCESS_RECOVERY_CODE_COOLDOWN_SECONDS=60
# ACCESS_RECOVERY_CODE_MAX_ATTEMPTS=5
# ACCESS_RECOVERY_CODE_LOCKOUT_MINUTES=15

# Customer recovery-code policy (separate counters from admin).
# ACCESS_CUSTOMER_RECOVERY_CODE_TTL_MINUTES=15
# ACCESS_CUSTOMER_RECOVERY_CODE_COOLDOWN_SECONDS=60
# ACCESS_CUSTOMER_RECOVERY_CODE_MAX_ATTEMPTS=5
# ACCESS_CUSTOMER_RECOVERY_CODE_LOCKOUT_MINUTES=15

# Customer JWT lifetime. The "remember me" branch fires when the login form
# checkbox is ticked; otherwise the short TTL applies.
# ACCESS_CUSTOMER_JWT_TTL_HOURS=168                # 24 * 7
# ACCESS_CUSTOMER_JWT_REMEMBER_ME_TTL_HOURS=720    # 24 * 30

# Owner role permission caps. The catalog tree flag is ALWAYS True regardless
# of env (UI relies on it). Other flags are read at JWT issuance — toggling
# requires the owner to re-login. See docs/subsystems/auth-permissions.md.
# ACCESS_OWNER_CAN_VIEW_CATEGORY_TREE=true
# ACCESS_OWNER_CAN_EDIT_TAXONOMY=false
# ACCESS_OWNER_CAN_VIEW_PRODUCTS=false
# ACCESS_OWNER_CAN_EDIT_PRODUCTS=false
# ACCESS_OWNER_CAN_VIEW_ORDERS=false
# ACCESS_OWNER_CAN_MANAGE_ORDERS=false
# ACCESS_OWNER_CAN_MANAGE_SETTINGS=false
# ACCESS_OWNER_CAN_CREATE_DEMO_DATA=false


# -----------------------------------------------------------------------------
# CATALOG — products, images, taxonomy
# Source: src/catalog/config.py
# -----------------------------------------------------------------------------

# Filesystem path (relative to project root) where product images are stored
# when storage backend = `local`. With backend = `s3`, this is ignored and
# Product.images[] holds absolute public URLs.
CATALOG_UPLOAD_DIR=media/products


# -----------------------------------------------------------------------------
# ORDERING — orders + inquiries (the Orders aggregate is feature-gated)
# Source: src/ordering/config.py · docs/subsystems/feature-flags.md
# -----------------------------------------------------------------------------

# Master switch for the Order aggregate. When false:
# - /orders*       (public)  is NOT registered
# - /admin/orders/*           is NOT registered
# - CORS rule for /orders*    is skipped in prod
# - orders-cards-wiring.js    is not loaded in the admin
# - /admin/requests/          collapses to inquiries-only view
# Inquiries (/inquiries*) are ALWAYS available — they're the public-contact flow.
ORDERING_ORDERS_ENABLED=true


# -----------------------------------------------------------------------------
# SYSTEM — global settings, recovery token, storage secrets, socials gating
# Source: src/system/config.py · docs/subsystems/feature-flags.md
# -----------------------------------------------------------------------------

# Recovery URL token: the URL https://.../recover/<token> triggers an admin
# password reset code via Telegram. Anyone who learns this value can request a
# code. Rotate periodically; do NOT publish.
SYSTEM_RECOVERY_TOKEN=change-me-in-production

# Fernet key (URL-safe base64, 32 raw bytes) used to encrypt
# storage_settings.secret_access_key_enc when backend = s3. Generate via:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required ONLY when switching backend to s3; leave empty for backend = local.
# Losing this key after writing an S3 secret = the secret cannot be decrypted.
SYSTEM_STORAGE_SECRETS_KEY=

# Social-channel visibility flags. Each one independently gates a field of
# /system/info, /system/settings AND the admin store form. A disabled channel
# is returned as `null` and the input is not rendered. Underlying DB columns
# always exist — flipping a flag back to true re-exposes the stored value.
SYSTEM_SOCIALS_INSTAGRAM_ENABLED=true
SYSTEM_SOCIALS_TELEGRAM_ENABLED=true
SYSTEM_SOCIALS_WHATSAPP_ENABLED=true
SYSTEM_SOCIALS_VIBER_ENABLED=true


# -----------------------------------------------------------------------------
# SMTP — outbound mail (customer password-recovery emails)
# Source: src/shared/adapters/driven/config.py · docs/infra/smtp.md
# -----------------------------------------------------------------------------

# Leave SMTP_HOST empty to disable email sending. Recovery requests will then
# log a warning and behave as if no account existed (no information disclosure).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true
# SMTP_TIMEOUT=10  # seconds


# -----------------------------------------------------------------------------
# MISC — runtime knobs read directly via os.environ
# -----------------------------------------------------------------------------

# Process port (used by the development entrypoint at src/root/entrypoints/api.py).
# Gunicorn in Docker binds 0.0.0.0:5000 via CMD; this var is for `python api.py`.
PORT=5000

# Flask debug auto-reload + verbose tracebacks. Never enable in prod.
FLASK_DEBUG=0

# Required for python -m / direct script invocations to resolve "from <ctx> import …".
# Compose / Dockerfile set this automatically.
PYTHONPATH=src

# When true, bulk admin actions (status-change, archive, etc.) are rate-limited
# per (admin_id, route) to avoid runaway loops. Disable in tests for speed.
# BULK_RATE_LIMIT_ENABLED=false


# -----------------------------------------------------------------------------
# DOCKER COMPOSE OVERRIDES
# -----------------------------------------------------------------------------
#
# docker-compose.yml hard-codes the following for the `api` service:
#   - PYTHONPATH=/app/src
#   - INFRA_DATABASE_URL=mysql+pymysql://shop:shop@db:3306/shop?charset=utf8mb4
# Anything you set here for those keys is overridden by compose. To change the
# DB connection inside the container, edit docker-compose.yml directly.
